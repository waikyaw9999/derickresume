# Copy to .env.local for `vercel dev`, and set the same values in the Vercel project dashboard.

# Required: long random string used to sign OTP challenges and sessions
AUTH_SECRET=change-me-to-a-long-random-secret

# Required: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Optional: verified sender on Resend (defaults to onboarding@resend.dev for testing)
OTP_FROM_EMAIL=access@juneko.online
OTP_FROM_NAME=JuneKo Portfolio

# Optional: where GitHub access requests are delivered (defaults to OTP_FROM_EMAIL / waikyaw9999@gmail.com)
GITHUB_ACCESS_NOTIFY_EMAIL=waikyaw9999@gmail.com
